# ========================================================
# FreshSip Juice Bar — Environment Configuration Template
# ========================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a strong 32+ character random string in production
SESSION_SECRET=freshsip_change_me_to_a_cryptographically_secure_random_string_2026

# Administrator Account Initial Bootstrap
ADMIN_EMAIL=admin@freshsip.com
ADMIN_PASSWORD=FreshSipAdmin2026!

# Email Service (SMTP) Configuration for Password Reset & Notifications
# If not configured, password reset links will safely log to console in local development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@freshsip.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="FreshSip Juice Bar <support@freshsip.com>"

# Google Gemini AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway Configuration (Optional Production Integration)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
